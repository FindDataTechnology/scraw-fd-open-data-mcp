# Shared crawl services. Canonical Redis = fd-redis on guangzhou-xinru (mesh
# 100.64.0.3) :30380, password-protected (real password in
# guangzhou-xinru:/etc/fd-open-data/db-credentials.env). From the Mac use the
# SSH tunnel (localhost:30380); from mesh peers guangzhou-xinru:30380.
REDIS_URL=redis://:FD_REDIS_PASSWORD@localhost:30380/0
SCRAPYD_URL=http://localhost:6800

# The canonical store (where semantic_observations lives): fd-postgres on
# guangzhou-xinru :30432, user fd, db fd_open_data. Legacy LAN
# 192.168.1.4:5433 retired read-only 2026-08-18.
FD_OPEN_DATA_MCP_DATABASE_URL=postgresql+psycopg2://fd:FD_PG_PASSWORD@localhost:30432/fd_open_data

# Audit output
JSONL_PATH=output/items.jl

# ── Document Storage (optional) ─────────────────────────────────────
# When crawling cn-report sources, PDFs can be saved locally and/or uploaded to MinIO.
# Leave empty/false to disable (default behavior).

# Local save: save PDFs to a directory (organized by stock_code)
# CNREPORT_SAVE_DIR=/app/output/reports

# MinIO upload: upload PDFs to object storage
# MINIO_UPLOAD_ENABLED=false
# MINIO_ENDPOINT=minio.minio.svc.cluster.local:9000  # in-cluster
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=fd-cn-reports
# MINIO_SECURE=false
